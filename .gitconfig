[pull]
	rebase = true
[push]
	autoSetupRemote = true
[core]
	filemode = true
	autocrlf = false
	ignorecase = true
	editor = nvim

[add.interactive]
    useBuiltin = false # required for git 2.37.0

[difftool]
    prompt = false

[pager]
    difftool = true

[diff]
    tool = difftastic
    external = difft

[difftool "difftastic"]
    cmd = difft "$MERGED" "$LOCAL" "abcdef1" "100644" "$REMOTE" "abcdef2" "100644"

[merge]
    conflictstyle = diff3

[user]
	signingkey = /Users/valery/.ssh/github_new.pub
	email = piashchynski.valery@gmail.com
	name = Valery Piashchynski

[commit]
	gpgsign = true
[url "git@github.com:"]
	insteadOf = https://github.com/
[url "git@gitlab.com:"]
	insteadOf = https://gitlab.com/
[url "git@bitbucket.org:"]
	insteadOf = https://bitbucket.org/
[url "git@git.spiralscout.com:"]
	insteadOf = https://git.spiralscout.com/

[includeIf "gitdir:~/projects/internal/roche/"]
	path = ~/.gitconfig-roche
[coderabbit]
	machineId = cli/2fb74a329ae04255a437b924c1455aa1
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = /Users/valery/.ssh/allowed_signers
